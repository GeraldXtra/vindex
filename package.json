{
  "name": "vindex",
  "productName": "Vindex",
  "version": "0.1.0",
  "description": "A fullscreen terminal with live system monitors.",
  "keywords": [
    "desktop",
    "sci-fi",
    "gui",
    "portable",
    "tty",
    "terminal"
  ],
  "main": "src/_boot.js",
  "scripts": {
    "start": "electron src",
    "install-linux": "npm install && cd src && npm install && cd .. && install-electron",
    "install-windows": "npm install && cd src && npm install && cd .. && install-electron",
    "prebuild-linux": "rsync -a --info=progress2 src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install",
    "prebuild-darwin": "rsync -a src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install",
    "prebuild-windows": "mkdir prebuild-src && xcopy src\\* prebuild-src\\ /E /C /Q /Y && node prebuild-minify.js && cd prebuild-src && npm install",
    "build-linux": "./node_modules/.bin/electron-builder build -l --x64 --arm64",
    "build-darwin": "./node_modules/.bin/electron-builder build -m",
    "build-windows": "node_modules\\.bin\\electron-builder build -w",
    "postbuild-linux": "rm -R prebuild-src",
    "postbuild-darwin": "rm -R prebuild-src",
    "postbuild-windows": "rmdir /S /Q prebuild-src",
    "test": "rsync -a --info=progress2 src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install && snyk test && cd .. && rm -R prebuild-src",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeraldXtra/vindex.git"
  },
  "author": "GeraldXtra (https://github.com/GeraldXtra)",
  "contributors": [
    "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev)"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/GeraldXtra/vindex/issues"
  },
  "homepage": "https://github.com/GeraldXtra/vindex#readme",
  "build": {
    "appId": "io.github.geraldxtra.vindex",
    "productName": "Vindex",
    "publish": "github",
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2017-2021 Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev), Copyright © 2026 GeraldXtra",
    "directories": {
      "output": "dist",
      "app": "prebuild-src"
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "artifactName": "Vindex-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "System",
      "icon": "media/linuxIcons"
    },
    "appImage": {
      "artifactName": "Vindex-Linux-${arch}.AppImage"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "media/icon.icns"
    },
    "dmg": {
      "artifactName": "Vindex-macOS-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon.ico"
    },
    "nsis": {
      "artifactName": "Vindex-Windows-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "clean-css": "5.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "node-json-minify": "1.0.0",
    "terser": "^5.9.0"
  },
  "optionalDependencies": {
    "cson-parser": "4.0.9"
  }
}
